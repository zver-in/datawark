# Copy this file to .env and replace every placeholder with a unique local value.
# Do not commit .env or reuse these values outside a local demonstration.
DATAWARK_GATEWAY_PORT=8080
DATAWARK_POSTGRES_SUPERUSER=datawark_admin
DATAWARK_POSTGRES_SUPERUSER_PASSWORD=replace-with-a-long-random-password
DATAWARK_POSTGRES_DB=datawark_demo
DATAWARK_DEMO_OWNER=datawark_demo_owner
DATAWARK_GATEWAY_DB_USER=datawark_gateway_reader
DATAWARK_GATEWAY_DB_PASSWORD=replace-with-a-different-long-random-password
DATAWARK_LOCAL_API_KEY=replace-with-a-long-random-api-key
